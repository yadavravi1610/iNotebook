# Server
PORT=5000
SECRET_KEY=your_jwt_secret_key

# MongoDB
MONGO_DB_URL=mongodb://localhost:27017/inotebook

# SMTP (required for OTP emails)
# Gmail example: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
